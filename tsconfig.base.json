      "@waifucave/clover-agent-runtime/workflow-worker": [
        "./packages/runtime/src/workflows/subprocess-entry.ts"
      ],
      "@waifucave/clover-agent-runtime/version": [
        "./packages/runtime/src/version.ts"
      ],
      "@waifucave/clover-agent-runtime/mcp-client": [
        "./packages/runtime/src/mcp-client.ts"
      ],
      "@waifucave/clover-agent-runtime/mcp-auth": [
        "./packages/runtime/src/mcp-auth.ts"
      ]
    }
  }
}
