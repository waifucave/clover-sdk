{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@waifucave/clover-agent-sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@waifucave/clover-agent-sdk/acp": [
        "./packages/sdk/src/acp/index.ts"
      ],
      "@waifucave/clover-agent-sdk/messaging": [
        "./packages/sdk/src/messaging/index.ts"
      ],
      "@waifucave/clover-agent-sdk/tools": [
        "./packages/sdk/src/tools/index.ts"
      ],
      "@waifucave/clover-provider-catalog": [
        "./packages/provider-catalog/src/index.ts"
      ],
      "@waifucave/clover-provider-catalog/families": [
        "./packages/provider-catalog/src/families.ts"
      ],
      "@waifucave/clover-provider-runtime": [
        "./packages/provider-runtime/src/index.ts"
      ],
      "@waifucave/clover-provider-runtime/testing": [
        "./packages/provider-runtime/src/testing.ts"
      ],
      "@waifucave/clover-conformance": [
        "./packages/conformance/src/index.ts"
      ],
      "@waifucave/clover-conformance/trace": [
        "./packages/conformance/src/trace.ts"
      ],
      "@waifucave/clover-conformance/official": [
        "./packages/conformance/src/official/index.ts"
      ],
      "@waifucave/clover-provider-conformance": [
        "./packages/provider-conformance/src/index.ts"
      ],
      "@waifucave/clover-provider-conformance/fakes": [
        "./packages/provider-conformance/src/fakes/index.ts"
      ],
      "@waifucave/clover-web": [
        "./packages/web/src/index.ts"
      ],
      "@waifucave/clover-agent-runtime": [
        "./packages/runtime/src/index.ts"
      ],
      "@waifucave/clover-agent-runtime/testing": [
        "./packages/runtime/src/testing.ts"
      ],
      "@waifucave/clover-agent-runtime/embedded": [
        "./packages/runtime/src/embedded.ts"
      ],
      "@waifucave/clover-agent-runtime/embedded-host": [
