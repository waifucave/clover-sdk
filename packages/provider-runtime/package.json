{
  "name": "@waifucave/clover-provider-runtime",
  "version": "0.0.68",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waifucave/clover-sdk.git",
    "directory": "packages/provider-runtime"
  },
  "homepage": "https://github.com/waifucave/clover-sdk",
  "bugs": {
    "url": "https://github.com/waifucave/clover-sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "bun": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"if(!/\\bpnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('pack/publish this package with pnpm. publishConfig.exports is a pnpm-only feature: under npm the override is ignored, so the packed manifest keeps a bun condition pointing at src/ -- which files does not ship -- and the tarball is broken for every Bun consumer while installing fine under Node. See RELEASING.md.')\""
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "winter": {
    "publish": {
      "npm": true
    }
  },
  "dependencies": {
    "@waifucave/clover-provider-catalog": "workspace:*"
  },
  "devDependencies": {
    "@waifucave/clover-agent-sdk": "workspace:*"
  }
}
